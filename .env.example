# Select `mock` until Atlas Sandbox access is configured.
VITE_FLIGHT_PROVIDER=mock

# Atlas Sandbox configuration. Keep values empty in this committed template.
ATLAS_BASE_URL=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_SANDBOX_API_KEY=

# Optional: set to true only after verifying Sandbox servicing support.
VITE_ENABLE_SANDBOX_SERVICING=false

# Agent provider: `mock`, `bailian`, or `deepseek`.
VITE_AGENT_PROVIDER=mock

# Preferred generic OpenAI-compatible configuration — server-side only.
# For DeepSeek use LLM_BASE_URL=https://api.deepseek.com and the model enabled
# for your account (for example deepseek-v4-flash).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional connection-research tool. Required only for live web evidence
# research; keep it server-side and never expose it with a VITE_ prefix.
TAVILY_API_KEY=

# Legacy Bailian / DashScope configuration, still supported by the proxy.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=
